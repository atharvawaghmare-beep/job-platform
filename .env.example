# Copy this file to .env and adjust as needed. Never commit the real .env.
# These defaults match docker-compose.yml's service credentials.

APP_ENV=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=jobplatform
POSTGRES_DB=jobplatform
# Host-relative URL for running the API outside Docker (e.g. `uvicorn` on your machine).
# docker-compose.yml overrides this to point at the `postgres` service hostname instead.
DATABASE_URL=postgresql+asyncpg://jobplatform:jobplatform@localhost:5433/jobplatform

# --- RabbitMQ ---
RABBITMQ_USER=jobplatform
RABBITMQ_PASSWORD=jobplatform
RABBITMQ_URL=amqp://jobplatform:jobplatform@localhost:5672/

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
